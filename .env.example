# Public site URL (used for canonical links, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://boldux.ca

# SMTP2GO — https://app.smtp2go.com/settings/apikeys/
SMTP2GO_API_KEY=api-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Sender must be on a verified sender domain in your SMTP2GO account
SMTP2GO_SENDER="Boldux Art <no-reply@boldux.ca>"
# Where contact-form messages are delivered
CONTACT_TO=boldux.ca@gmail.com

# Optional: inertial (Lenis) smooth scrolling. Off by default; native scrolling is smoother on most Windows laptops.
# NEXT_PUBLIC_SMOOTH_SCROLL=1
